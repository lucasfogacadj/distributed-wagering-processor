{
  "realm": "wagering",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "wagering-operator",
        "description": "Backoffice do operador: cria wallets, lê o ledger, reconcilia"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "wagering-api",
      "description": "Audiência da API de wagering + papéis de realm (o import com clientScopes explícitos não cria os escopos embutidos)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "audience wagering-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "wagering-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "provider-a",
      "name": "Provedor de jogos A",
      "enabled": true,
      "publicClient": false,
      "secret": "provider-a-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "wagering-api"
      ],
      "protocolMappers": [
        {
          "name": "provider_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "name": "Provedor de jogos B",
      "enabled": true,
      "publicClient": false,
      "secret": "provider-b-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "wagering-api"
      ],
      "protocolMappers": [
        {
          "name": "provider_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "backoffice",
      "name": "Backoffice do operador",
      "enabled": true,
      "publicClient": false,
      "secret": "backoffice-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "wagering-api"
      ]
    },
    {
      "clientId": "no-rights",
      "name": "Client autenticável sem nenhum direito (usado nos testes de 403)",
      "enabled": true,
      "publicClient": false,
      "secret": "no-rights-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "wagering-api"
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-backoffice",
      "enabled": true,
      "serviceAccountClientId": "backoffice",
      "realmRoles": [
        "wagering-operator"
      ]
    }
  ]
}
