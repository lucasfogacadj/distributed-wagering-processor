{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:int": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun run test/load/load-test.ts",
    "test:load:outbox": "bun run test/load/outbox-bench.ts",
    "test:all": "bun test test/unit test/integration test/concurrency",
    "test:coverage": "bun test test/unit test/integration --coverage",
    "infra:up": "docker compose up -d --wait postgres localstack keycloak",
    "infra:down": "docker compose down",
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "migrate:up": "bun run src/infrastructure/database/migrate-cli.ts up",
    "migrate:down": "bun run src/infrastructure/database/migrate-cli.ts down",
    "outbox:requeue": "bun run src/infrastructure/database/outbox-requeue-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1147.0",
    "@mikro-orm/core": "^7.2.4",
    "@mikro-orm/migrations": "^7.2.4",
    "@mikro-orm/postgresql": "^7.2.4",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  }
}
